# ============================================================
# AI Data Assistant — пример переменных окружения.
# Скопируйте в `.env` и заполните реальными значениями.
# `.env` НЕ коммитируется (см. .gitignore).
# ============================================================

# --- Базовые настройки приложения (bootstrap, требуют рестарта) ---
APP_NAME=Data Assistant
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Хранилища и пути ---
# Лимит размера загружаемого файла. Операторский параметр —
# менять можно в runtime через /admin без рестарта; здесь — умолчание.
MAX_FILE_SIZE=10MB
# UPLOAD_DIR=storage/uploads
# OUTPUT_DIR=storage/outputs
# STORAGE_DIR=storage
# TEMPLATES_DIR=templates
# STATIC_DIR=static

# --- Провайдер модели ---
# Ключ API провайдера. Для OpenAI: sk-... Длина ~164 символа.
OPENAI_API_KEY=YOUR_API_KEY
# Имя модели. Операторский параметр (runtime).
OPENAI_MODEL=gpt-5-mini
# OpenAI-совместимый endpoint. Для альтернативных провайдеров (GigaChat,
# YandexGPT, Gemini) укажите их base_url. Операторский параметр (runtime).
OPENAI_BASE_URL=https://api.openai.com/v1
# Сколько последних сообщений чата передавать в модель. Операторский (runtime).
OPENAI_MAX_HISTORY_MESSAGES=8
# Температура модели (0–2). Отправляется в запрос ТОЛЬКО если оператор явно
# задал её в /admin; иначе провайдер использует своё умолчание. Важно: некоторые
# модели (gpt-5-mini и др.) поддерживают только умолчательную температуру.
# Операторский параметр (runtime).
OPENAI_TEMPERATURE=0.0
# Seed для воспроизводимости. Пусто = не отправляется (поддерживают не все
# провайдеры). Операторский параметр (runtime).
OPENAI_SEED=
# Отображаемое имя провайдера в контенте. Пусто = нейтрально.
# Операторский параметр (runtime).
PROVIDER_NAME=
# Structured output (json_schema). Вкл — строгий контракт (OpenAI и
# совместимые). Выкл — свободный ответ + устойчивый парсер (для провайдеров
# без поддержки). Операторский параметр (runtime).
STRUCTURED_OUTPUT=true

# --- Промпты и специализация ---
# Каталог версионированных промптов.
# PROMPTS_DIR=prompts
# Специализация ассистента в системном промпте. Операторский параметр (runtime).
ASSISTANT_SPECIALIZATION=AI Data Assistant — аналитик данных общего профиля

# --- Runtime-config (вариант 3) ---
# Путь к JSON-файлу операторских параметров. Правка применяется в runtime.
# RUNTIME_CONFIG_PATH=storage/config.json

# --- Админка оператора (вариант 3) ---
# Токен доступа к /admin (HTTP Basic, пользователь `admin`, пароль = токен).
# Пусто/отсутствует — админка отключена (403). Bootstrap-параметр (рестарт).
ADMIN_TOKEN=YOUR_ADMIN_TOKEN