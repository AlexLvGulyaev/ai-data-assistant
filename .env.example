# ============================================================
# AI Data Assistant — пример переменных окружения.
# Скопируйте в `.env` и заполните реальными значениями.
# `.env` НЕ коммитируется (см. .gitignore).
#
# В .env живут ТОЛЬКО секреты и bootstrap-параметры (рестарт).
# Операторские параметры (модель, endpoint, специализация, температура,
# лимиты файла и т.п.) единственным источником истины имеют
# storage/config.json — начальные значения сеются из хардкоженных умолчаний
# при первом старте, дальше оператор правит их через /admin БЕЗ рестарта.
# В .env операторских параметров НЕТ — это намеренно (одна точка правки).
# ============================================================

# --- Базовые настройки приложения (bootstrap, требуют рестарта) ---
APP_NAME=Data Assistant
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Хранилища и пути (bootstrap, рестарт) ---
# UPLOAD_DIR=storage/uploads
# OUTPUT_DIR=storage/outputs
# STORAGE_DIR=storage
# TEMPLATES_DIR=templates
# STATIC_DIR=static
# PROMPTS_DIR=prompts
# RUNTIME_CONFIG_PATH=storage/config.json

# --- Секреты (только .env, рестарт) ---
# Ключ API провайдера. Для OpenAI: sk-... Длина ~164 символа.
# Для YandexGPT этот же слот хранит API-ключ Yandex (Bearer) + папка folder_id
# задаётся в /admin (runtime-ключ yandex_folder_id).
OPENAI_API_KEY=YOUR_API_KEY
# Authorization key GigaChat (Сбер) — нужен только при выборе пресета «GigaChat»
# в /admin. Для OpenAI/YandexGPT/«Свой» оставьте пустым.
#GIGACHAT_AUTH_KEY=YOUR_GIGACHAT_AUTH_KEY
# Опционально: путь к CA-bundle для проверки TLS GigaChat (сертификат Минцифры).
# Без него проверка TLS отключается (ssl.CERT_NONE) — приемлемо для dev/демо.
#GIGACHAT_CA_BUNDLE=/etc/ssl/certs/russian-trusted-ca.pem
# Токен доступа к /admin (HTTP Basic, пользователь `admin`, пароль = токен).
# Пусто/отсутствует — админка отключена (403).
ADMIN_TOKEN=YOUR_ADMIN_TOKEN

# --- Где менять операторские параметры (НЕ здесь) ---
# Провайдер (пресет):     /admin → «Провайдер» (OpenAI / GigaChat / YandexGPT / Свой)
# Модель:                 /admin → «Модель» (умолч. gpt-5-mini)
# Endpoint провайдера:    /admin → «Endpoint» (умолч. OpenAI)
# Специализация:          /admin → «Специализация» (умолч. общий профиль)
# Structured output:      /admin → «Structured output» (умолч. Вкл)
# Температура/seed:        /admin → opt-in (не сеются; отправляются только если заданы)
# Yandex folder_id:       /admin → opt-in (нужен только для пресета YandexGPT)
# Лимит размера файла:    /admin → «Лимит размера файла» (умолч. 10MB)
# Системный промпт:       /admin → «Системный промпт» (файл prompts/v1/system.md)